{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-users-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/wallet/{**catch-all}"
        }
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/transactions/{**catch-all}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "transaction-service": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}
